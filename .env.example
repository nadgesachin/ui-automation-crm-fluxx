# ===========================================
# UI Automation Framework - Environment Config
# ===========================================
# Copy this file to .env and fill in values

# Environment (dev | stage | prod)
TEST_ENV=dev

# SSO Credentials (Microsoft Azure AD)
SSO_EMAIL=your_email@ciffconsultants.org
SSO_PASSWORD=your_password_here

# Browser Settings
HEADLESS=true
SLOW_MO=0

# Retry Configuration
SYNC_MAX_RETRIES=24
SYNC_RETRY_DELAY_MS=5000
